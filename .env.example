# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=playce_db
# Or use full connection URL:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/playce_db

# Redis Configuration
REDIS_URL=redis://localhost:6379
# Or discrete parameters:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# JWT Secrets
JWT_ACCESS_SECRET=playce_access_super_secret_jwt_key_2026
JWT_REFRESH_SECRET=playce_refresh_super_secret_jwt_key_2026
JWT_RESET_SECRET=playce_reset_super_secret_jwt_key_2026

# Resend Email Configuration
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Swagger Documentation Basic Auth Credentials
SWAGGER_USER=admin
SWAGGER_PASSWORD=playce_docs_pass
